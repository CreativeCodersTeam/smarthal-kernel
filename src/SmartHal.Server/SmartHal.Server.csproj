<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      Source 4 of the configuration stack (IF-3) reads user secrets in the Development environment.
      AddUserSecrets resolves the store through the UserSecretsIdAttribute that this property emits;
      without it the source would silently be absent.
    -->
    <UserSecretsId>smarthal-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <!-- FR-22: ValidateDataAnnotations() checks the attributes on SmartHalOptions at start. -->
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!--
      FR-39: the readiness signal. This is the host-neutral health check package, not an ASP.NET one:
      FR-41 forbids a transport, so the state stays readable through HealthCheckService and the log.
    -->
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Logging (FR-28 to FR-31). Serilog is referenced by this project alone and used by its
      composition root alone (FR-27, FR-60); the sinks and the compact formatter are named in the
      Serilog section of appsettings.json and loaded from these assemblies at run time.
    -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sources 1 and 2 of the configuration stack; the test projects receive them through the project reference. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SmartHal.Core/SmartHal.Core.csproj" />
    <ProjectReference Include="../SmartHal.Core.Abstractions/SmartHal.Core.Abstractions.csproj" />
    <ProjectReference Include="../SmartHal.Adapter.Sdk/SmartHal.Adapter.Sdk.csproj" />
    <ProjectReference Include="../SmartHal.Contracts/SmartHal.Contracts.csproj" />
  </ItemGroup>

</Project>
