{
  "SmartHal": {},
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": {
      // Named instead of numbered, so appsettings.Development.json and an environment variable can
      // address a single sink instead of replacing the whole list.
      "Console": {
        "Name": "Console",
        "Args": {
          // Written as an object because appsettings.Development.json replaces the formatter with one
          // that takes an output template; Serilog rejects an argument that is a scalar in one source
          // and a section in another.
          "formatter": {
            "type": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      },
      "File": {
        "Name": "File",
        "Args": {
          "path": "./logs/smarthal-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    }
  }
}
